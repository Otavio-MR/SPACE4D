{
  "name": "orbita-ar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cartas de realidade aumentada sobre o Sistema Solar, com foco em usabilidade e acessibilidade (WCAG 2.2).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cards:generate": "node tools/cards/generate.ts",
    "cards:compile": "node tools/cards/compile.ts",
    "cards": "npm run cards:generate && npm run cards:compile",
    "icons": "node tools/icons/generate.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router": "^8.3.1",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "1.56.1",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0"
  }
}
